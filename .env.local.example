# ============================================================
# TRITON GAMING — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in the values.
# ============================================================

# Supabase (required)
# Find these in your Supabase project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://eoakwedvvpuoncplnfwr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — used server-side only, never expose to client
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL — used for OAuth redirect URLs
# Development: http://localhost:3000
# Production:  https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# SUPABASE OAUTH SETUP
# ============================================================
# 1. Go to Supabase Dashboard > Authentication > Providers
# 2. Enable Google provider
# 3. Add your Google OAuth credentials (Client ID + Secret)
#    from https://console.cloud.google.com/
# 4. Set Authorized redirect URI in Google Console to:
#    https://<your-supabase-project>.supabase.co/auth/v1/callback
# 5. In Supabase > Auth > URL Configuration, add:
#    Site URL: https://yourdomain.com (or http://localhost:3000)
#    Redirect URLs: https://yourdomain.com/auth/callback
# ============================================================

# Optional: Legacy MongoDB (kept for reference, no longer used)
# ATLAS_URI=
# DB_NAME=website_db
