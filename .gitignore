# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

# vercel
.vercel

# supabase CLI
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# Next.js auto-regenerates these at the repo root on every `next dev` run
# (see node_modules/next/dist/server/lib/generate-agent-files.js) — always
# disposable, never worth committing.
/AGENTS.md
/CLAUDE.md

# .agents/AGENTS.md and .agents/CLAUDE.md are copies of that same
# auto-generated content, not hand-authored project docs — ignored for the
# same reason. .agents/skills/ is NOT ignored (see below) — that's real,
# non-generated reference material (Supabase skill packages) that should
# stay in version control.
.agents/AGENTS.md
.agents/CLAUDE.md

# Creative assets such as images, videos, and audio files
.assets/

# Windows alternate data streams
:Zone.Identifier 


# Second dev server used for testing (NEXT_DIST_DIR=.next-qa)
/.next-qa/
