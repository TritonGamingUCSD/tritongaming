NEXT_PUBLIC_SUPABASE_URL=https://eoakwedvvpuoncplnfwr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service-role key — bypasses RLS. Server-only, never expose to the client.
# Used by admin role management and the Stripe webhook ticket creation.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — used to charge non-UCSD attendees for paid public events.
# Secret key from the Stripe dashboard (Developers > API keys).
STRIPE_SECRET_KEY=
# Signing secret for the /api/stripe/webhook endpoint (Developers > Webhooks,
# or `stripe listen --print-secret` when testing locally with the Stripe CLI).
STRIPE_WEBHOOK_SECRET=

VERCEL_API_TOKEN=

VERCEL_PROJECT_ID=
