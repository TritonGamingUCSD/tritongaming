# Environment variables. Copy to .env.local and fill in. Never commit real values.

# Site
# NEXT_PUBLIC_SITE_URL: Your site address. Locally http://localhost:3000, in production https://your-domain
NEXT_PUBLIC_SITE_URL=

# Supabase
# NEXT_PUBLIC_SUPABASE_URL: Supabase dashboard > Project Settings > API
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: same page (safe for the browser)
# SUPABASE_SERVICE_ROLE_KEY: same page. SECRET, server only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
# STRIPE_SECRET_KEY: Stripe > Developers > API keys. SECRET
# STRIPE_WEBHOOK_SECRET: Stripe > Developers > Webhooks (signing secret). SECRET
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Scheduled jobs
# CRON_SECRET: any long random string: openssl rand -hex 32. SECRET
CRON_SECRET=

# Push notifications
# NEXT_PUBLIC_VAPID_PUBLIC_KEY: web push public key
# VAPID_PRIVATE_KEY: web push private key. SECRET
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Optional ──────────────────────────────────

# Admin deployment status (shows in Admin > System Health)
# VERCEL_API_TOKEN: Vercel > Account Settings > Tokens. SECRET
# VERCEL_PROJECT_ID: Vercel project > Settings > General
# VERCEL_TEAM_ID: only if the project is in a team
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Other
# VAPID_SUBJECT: defaults to the site address
# BASE_URL: local test scripts only, defaults to http://localhost:3000
VAPID_SUBJECT=
BASE_URL=

# Development only
# DEV_NOTIFY_TEST_ONLY: set to 1 when testing against the live database. A dev server then only notifies throwaway accounts whose name starts with ZZ,
#   never real members. Ignored in production.
# NEXT_DIST_DIR: run a second dev server for testing, e.g. NEXT_DIST_DIR=.next-qa npx next dev -p 3101
DEV_NOTIFY_TEST_ONLY=

