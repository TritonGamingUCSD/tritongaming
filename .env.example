# Triton Gaming environment. Copy this file to .env.local and fill it in (.env.local is git-ignored).
# Required unless marked optional. Never commit real values. Values marked SECRET must stay server-side.
# On Vercel, VERCEL_ENV and VERCEL_GIT_* are provided automatically; do not set them.

# ─── Site ────────────────────────────────────────────────────────
# Where the site lives. Locally this is http://localhost:3000; in production, the real https:// address.
NEXT_PUBLIC_SITE_URL=

# ─── Supabase ────────────────────────────────────────────────────
# Database and sign-in. Dashboard > Project Settings > API.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: Safe for the browser.
# SUPABASE_SERVICE_ROLE_KEY: SECRET. Bypasses row-level security. Server only, never expose it to the browser. Used by admin routes, the Stripe webhook, and the portal's data routes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ──────────────────────────────────────────────────────
# Charges non-UCSD attendees for paid public events. Dashboard > Developers.
# STRIPE_SECRET_KEY: API keys > Secret key.
# STRIPE_WEBHOOK_SECRET: Webhooks > signing secret for /api/stripe/webhook (or `stripe listen --print-secret` locally).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Scheduled jobs ──────────────────────────────────────────────
# Vercel Cron sends this as a Bearer token to every /api/cron/* route (reminders, quarter and team sync, storage tidy-up). Use any long random string.
# CRON_SECRET: `openssl rand -hex 32`
CRON_SECRET=

# ─── Web push (VAPID) ────────────────────────────────────────────
# Browser notifications. The two keys must be set identically in the live site's environment.
# VAPID_PRIVATE_KEY: SECRET.
# VAPID_SUBJECT: Optional: a https:// address or mailto:. Defaults to the site address.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=

# ─── Google Calendar linking (optional) ──────────────────────────
# Lets members link their Google Calendar (see the README, "Linking Google Calendar"). Leave unset to turn the feature off.
# GOOGLE_CALENDAR_CLIENT_ID: Google Cloud Console > Credentials > OAuth client.
# GOOGLE_CALENDAR_CLIENT_SECRET: SECRET.
# CALENDAR_TOKEN_KEY: SECRET. Encrypts stored Google tokens: `openssl rand -base64 32`. Do not change it once members have linked.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# CALENDAR_TOKEN_KEY=

# ─── Admin: deployment status (optional) ─────────────────────────
# Shows the latest deployment in Admin > System Health.
# VERCEL_API_TOKEN: SECRET. Vercel > Account Settings > Tokens.
# VERCEL_TEAM_ID: Only if the project belongs to a team.
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# ─── Local scripts (optional) ────────────────────────────────────
# Used by the scripts/ checks, not by the site.
# BASE_URL: Defaults to http://localhost:3000.
# BASE_URL=
