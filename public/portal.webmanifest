{
  "id": "/portal",
  "name": "Triton Gaming Portal",
  "short_name": "TG Portal",
  "description": "The Triton Gaming member portal: tickets, check-in, meetings and more.",
  "start_url": "/portal",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f3f1ea",
  "theme_color": "#011941",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My Tickets", "url": "/portal/tickets", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Scan", "url": "/portal/scan", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
